# =====================================================================
# AI Camera Monitoring - Environment Template (.env.example)
# =====================================================================

# Primary CCTV / IP Camera RTSP Configuration
RTSP_URL=rtsp://admin:password123@192.168.1.100:554/h264Preview_01_main

# Primary Camera Metadata
CAMERA_ID=gate_camera_1
CAMERA_LOCATION=Main Gate Entrance
CAMERA_NAME=Main Gate CCTV

# Multi-Camera RTSP Streams (Optional)
RTSP_URL_GATE_1=rtsp://admin:password123@192.168.1.100:554/h264Preview_01_main
RTSP_LOCATION_GATE_1=Main Gate Entrance

RTSP_URL_GATE_2=rtsp://admin:password123@192.168.1.101:554/h264Preview_01_main
RTSP_LOCATION_GATE_2=North Parking Entrance

# RTSP Stream Optimization & Frame Throttling
PROCESS_EVERY_N_FRAMES=2
FRAME_PROCESSING_FPS=25.0
RTSP_TRANSPORT=tcp

# Detection Cooldown & De-duplication (in seconds)
DETECTION_COOLDOWN_SECONDS=60.0

# Fallback Physical Webcam Device Index (if RTSP_URL is empty)
CAMERA_INDEX=0

# AI Detection & Recognition
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.40
YOLO_ALLOWED_CLASSES=person,cell phone,mobile phone,laptop,backpack,bottle,chair,car,motorcycle,dog,bus,truck,bicycle

# Calibrated Open-World Rejection Threshold
RECOGNITION_THRESHOLD=0.85
CONFIDENCE_THRESHOLD=0.85

# Server Settings
HOST=0.0.0.0
PORT=5001
FLASK_SECRET_KEY=ai-camera-monitoring-secret-key-2026
